#!/usr/bin/env bash
set -Eeuo pipefail

readonly PROFILE_DIR_NAME=.config/nonoos
readonly PROFILE_FILE_NAME=profile

usage() {
    cat <<'EOF'
Usage :
  nonoos-profile
  nonoos-profile --show [--user NOM]
  nonoos-profile --set standard|developer|support [--user NOM]

Sans option, affiche le menu de sélection pour le compte courant.
L'option --user est réservée à root.
EOF
}

profile_label() {
    case "$1" in
        standard)  printf '%s' "Standard" ;;
        developer) printf '%s' "Développeur" ;;
        support)   printf '%s' "Support technique" ;;
        *) return 1 ;;
    esac
}

profile_description() {
    case "$1" in
        standard)  printf '%s' "Usage quotidien du bureau" ;;
        developer) printf '%s' "Développement logiciel" ;;
        support)   printf '%s' "Diagnostic et assistance" ;;
        *) return 1 ;;
    esac
}

action=menu
profile=""
target_user=""
user_option=no
action_option=no
while (($#)); do
    case "$1" in
        --show)
            if [[ "$action_option" = yes ]]; then
                echo "Erreur : choisissez une seule action." >&2
                usage >&2
                exit 2
            fi
            action=show
            action_option=yes
            shift
            ;;
        --set)
            if (($# < 2)); then
                echo "Erreur : --set nécessite un profil." >&2
                usage >&2
                exit 2
            fi
            if [[ "$action_option" = yes ]]; then
                echo "Erreur : choisissez une seule action." >&2
                usage >&2
                exit 2
            fi
            action=set
            profile=$2
            action_option=yes
            shift 2
            ;;
        --user)
            if (($# < 2)); then
                echo "Erreur : --user nécessite un nom de compte." >&2
                usage >&2
                exit 2
            fi
            target_user=$2
            user_option=yes
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Erreur : option inconnue : $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z "$target_user" ]]; then
    target_user=${SUDO_USER:-${USER:-}}
fi

if [[ -z "$target_user" ]]; then
    echo "Erreur : impossible de déterminer le compte utilisateur." >&2
    exit 1
fi

if [[ "$user_option" = yes && "$EUID" -ne 0 ]]; then
    echo "Erreur : --user est réservé à root." >&2
    exit 1
fi

passwd_entry=$(getent passwd "$target_user") || {
    printf 'Erreur : compte utilisateur introuvable : %s\n' "$target_user" >&2
    exit 1
}
IFS=: read -r _ _ target_uid target_gid _ target_home _ <<<"$passwd_entry"
if [[ ! "$target_uid" =~ ^[0-9]+$ ]] || ((target_uid < 1000 || target_uid >= 65534)) ||
   [[ ! "$target_gid" =~ ^[0-9]+$ ]] || [[ -z "$target_home" || "$target_home" != /* ]]; then
    printf 'Erreur : %s n’est pas un compte utilisateur standard.\n' "$target_user" >&2
    exit 1
fi

if [[ "$EUID" -ne 0 ]] && [[ "$target_uid" != "$EUID" ]]; then
    echo "Erreur : vous ne pouvez gérer que votre propre profil." >&2
    exit 1
fi

profile_path="$target_home/$PROFILE_DIR_NAME/$PROFILE_FILE_NAME"

show_profile() {
    local current=""
    if [[ -r "$profile_path" ]]; then
        IFS= read -r current < "$profile_path" || true
    fi
    if ! profile_label "$current" >/dev/null 2>&1; then
        printf 'Aucun profil personnel enregistré pour %s.\n' "$target_user"
        return 0
    fi
    printf 'Profil de %s : %s (%s)\n' \
        "$target_user" "$(profile_label "$current")" "$(profile_description "$current")"
}

choose_profile() {
    local choice=""
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
        choice=$(zenity --list --radiolist \
            --title="Profil utilisateur NonoOS" \
            --text="Choisissez votre profil personnel" \
            --column="" --column="Code" --column="Profil" \
            --hide-column=2 --print-column=2 \
            TRUE standard "Standard — usage quotidien" \
            FALSE developer "Développeur — développement logiciel" \
            FALSE support "Support — diagnostic et assistance" \
            --width=480 --height=360 2>/dev/null) || return 1
    elif command -v whiptail >/dev/null 2>&1; then
        choice=$(whiptail --title "Profil utilisateur NonoOS" \
            --menu "Choisissez votre profil personnel" 14 68 3 \
            standard "Usage quotidien du bureau" \
            developer "Développement logiciel" \
            support "Diagnostic et assistance" 3>&1 1>&2 2>&3) || return 1
    else
        printf '%s\n' \
            "Choisissez un profil :" \
            "  1) Standard — usage quotidien" \
            "  2) Développeur — développement logiciel" \
            "  3) Support — diagnostic et assistance" >&2
        printf 'Votre choix [1-3] : ' >&2
        read -r choice
        case "$choice" in
            1|standard) choice=standard ;;
            2|developer) choice=developer ;;
            3|support) choice=support ;;
            *) return 1 ;;
        esac
    fi
    profile=$choice
}

save_profile() {
    local config_dir="$target_home/$PROFILE_DIR_NAME"
    local path

    if ! profile_label "$profile" >/dev/null 2>&1; then
        printf 'Erreur : profil inconnu : %s\n' "$profile" >&2
        usage >&2
        return 2
    fi
    if [[ -L "$target_home" || ! -d "$target_home" ]]; then
        printf 'Erreur : dossier personnel absent ou lien symbolique : %s\n' "$target_home" >&2
        return 1
    fi

    for path in "$target_home/.config" "$config_dir"; do
        if [[ -L "$path" ]]; then
            printf 'Erreur : refus d’utiliser un dossier de configuration symbolique : %s\n' "$path" >&2
            return 1
        fi
        if [[ ! -e "$path" ]]; then
            if [[ "$EUID" -eq 0 ]]; then
                install -d -o "$target_uid" -g "$target_gid" -m 0700 -- "$path"
            else
                mkdir -m 0700 -- "$path"
            fi
        fi
        if [[ ! -d "$path" ]] || [[ "$(stat -c '%u' -- "$path")" != "$target_uid" ]]; then
            printf 'Erreur : dossier de configuration non détenu par %s : %s\n' "$target_user" "$path" >&2
            return 1
        fi
    done

    local temporary_file
    temporary_file=$(mktemp)
    printf '%s\n' "$profile" > "$temporary_file"
    if [[ "$EUID" -eq 0 ]]; then
        if ! install -o "$target_uid" -g "$target_gid" -m 0600 \
            -- "$temporary_file" "$profile_path"; then
            rm -f -- "$temporary_file"
            return 1
        fi
    else
        chmod 0600 "$temporary_file"
        if ! mv -f -- "$temporary_file" "$profile_path"; then
            rm -f -- "$temporary_file"
            return 1
        fi
    fi
    rm -f -- "$temporary_file"
    printf 'Profil de %s défini sur %s (%s).\n' \
        "$target_user" "$(profile_label "$profile")" "$(profile_description "$profile")"
    printf '%s\n' "Ce choix ne modifie ni les droits du compte ni les logiciels installés."
}

case "$action" in
    show)
        show_profile
        ;;
    set)
        save_profile
        ;;
    menu)
        if choose_profile; then
            save_profile
        else
            echo "Sélection annulée ou indisponible ; profil inchangé." >&2
            exit 1
        fi
        ;;
esac
