[Unit]
Description=Assistant de récupération au démarrage NonoOS
After=systemd-udev-settle.service newdistrib-first-boot.service
Before=display-manager.service
ConditionPathExists=/var/lib/newdistrib/first-boot-done

[Service]
Type=oneshot
ExecStart=/etc/init.d/nonoos-recovery-hotkey
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
