#!/usr/bin/env bash
# nonoos - configuration au premier démarrage
# Choix : langue, clavier, environnements et profil utilisateur.
# Cible : systèmes basés sur Debian/Ubuntu (apt).
#
# Interface (détectée automatiquement, dans cet ordre) :
#   1. graphique (zenity)   si une session graphique est disponible
#   2. terminal  (whiptail) sinon
#   3. texte brut           en dernier recours
#
# Usage :
#   newdistrib-first-boot.sh                 # première configuration
#   newdistrib-first-boot.sh --install-only  # relance seulement l'installation
#                                            # des profils déjà enregistrés
#fenetre de connexion wifi

STATE_DIR=/var/lib/newdistrib
SUDOERS_DIR=${SUDOERS_DIR:-/etc/sudoers.d}
MARKER="$STATE_DIR/first-boot-done"
SETUP_READY_MARKER="$STATE_DIR/setup-ready"
PROFILE_FILE="$STATE_DIR/profile"
LOCALE_FILE=/etc/default/locale
KEYBOARD_FILE=/etc/default/keyboard
PKG_DIR=/usr/share/newdistrib/packages     # une liste par profil : <profil>.list
LOG_FILE=/var/log/newdistrib-first-boot.log
TITLE="nonoos"

# Valeurs par défaut
LANG_CHOICE="fr_FR.UTF-8"
KB_CHOICE="fr"
PROFILES="office"
USER_PROFILE="standard"
SSH_ENABLED="no"
BLUETOOTH_ENABLED="no"
INSTALL_STATUS=""
FIRST_BOOT_FAILURES=""
FIRST_BOOT_FAILED=no
PACKAGE_FAILED=no
UI=text        # gui | whiptail | text

# ---------------------------------------------------------------------------
# Utilitaires
# ---------------------------------------------------------------------------

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

record_failure() {
    local message="$1"
    log "ERREUR : $message"
    if [ -n "$FIRST_BOOT_FAILURES" ]; then
        FIRST_BOOT_FAILURES+=$'\n'
    fi
    FIRST_BOOT_FAILURES+="- $message"
    FIRST_BOOT_FAILED=yes
}

has_whiptail() {
    command -v whiptail >/dev/null 2>&1
}

# Doit être exécuté en root
if [ "$(id -u)" -ne 0 ]; then
    echo "Ce script doit être lancé en root." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Interface utilisateur : graphique (zenity) / terminal (whiptail) / texte
# ---------------------------------------------------------------------------

detect_ui() {
    UI=text
    has_whiptail && UI=whiptail

    if command -v zenity >/dev/null 2>&1; then
        if [ -n "$DISPLAY" ]; then
            if command -v xdpyinfo >/dev/null 2>&1; then
                xdpyinfo >/dev/null 2>&1 && UI=gui
            else
                UI=gui
            fi
        elif [ -n "$WAYLAND_DISPLAY" ]; then
            UI=gui
        fi
    fi
}

# Appelé si zenity échoue à s'afficher (pas d'accès à l'écran, etc.)
fallback_ui() {
    UI=text
    has_whiptail && UI=whiptail
    log "Interface graphique indisponible, repli sur : $UI"
}

# --- Menu à choix unique ----------------------------------------------------
# ui_menu TITRE TEXTE DEFAUT tag1 desc1 tag2 desc2 ...   -> affiche le tag choisi

_gui_menu() {
    title=$1; text=$2; def=$3; shift 3
    n=$(( $# / 2 )); i=0
    while [ "$i" -lt "$n" ]; do
        tag=$1; desc=$2; shift 2
        if [ "$tag" = "$def" ]; then st=TRUE; else st=FALSE; fi
        set -- "$@" "$st" "$tag" "$desc"
        i=$((i + 1))
    done
    zenity --list --radiolist --title="$title" --text="$(printf '%b' "$text")" \
        --column="" --column="Code" --column="Choix" \
        --hide-column=2 --print-column=2 \
        --width=460 --height=460 "$@" 2>/dev/null
}

_wt_menu() {
    title=$1; text=$2; def=$3; shift 3
    n=$(( $# / 2 ))
    whiptail --title "$title" --default-item "$def" \
        --menu "$text" $((n + 8)) 64 "$n" "$@" 3>&1 1>&2 2>&3
}

_txt_menu() {
    text=$2; def=$3; shift 3
    printf '%b\n' "$text" >&2
    i=1
    while [ $# -ge 2 ]; do
        echo "  $i) $2" >&2
        eval "TAG_$i=\$1"
        i=$((i + 1)); shift 2
    done
    printf "Votre choix [1-%s] (Entrée = défaut) : " "$((i - 1))" >&2
    read -r c
    sel=""
    case "$c" in
        ''|*[!0-9]*) ;;
        *) eval "sel=\${TAG_$c:-}" ;;
    esac
    [ -z "$sel" ] && sel=$def
    echo "$sel"
}

ui_menu() {
    if [ "$UI" = gui ]; then
        out=$(_gui_menu "$@"); rc=$?
        if [ "$rc" -le 1 ]; then printf '%s\n' "$out"; return 0; fi
        fallback_ui
    fi
    case "$UI" in
        whiptail) _wt_menu "$@" ;;
        *)        _txt_menu "$@" ;;
    esac
}

# --- Liste à cases à cocher --------------------------------------------------
# ui_checklist TITRE TEXTE tag1 desc1 ON|OFF ...   -> affiche les tags cochés

_gui_checklist() {
    title=$1; text=$2; shift 2
    n=$(( $# / 3 )); i=0
    while [ "$i" -lt "$n" ]; do
        tag=$1; desc=$2; state=$3; shift 3
        if [ "$state" = "ON" ]; then st=TRUE; else st=FALSE; fi
        set -- "$@" "$st" "$tag" "$desc"
        i=$((i + 1))
    done
    zenity --list --checklist --title="$title" --text="$(printf '%b' "$text")" \
        --column="" --column="Code" --column="Environnement" \
        --hide-column=2 --print-column=2 --separator=" " \
        --width=480 --height=440 "$@" 2>/dev/null
}

_wt_checklist() {
    title=$1; text=$2; shift 2
    n=$(( $# / 3 ))
    whiptail --title "$title" --separate-output \
        --checklist "$text" $((n + 9)) 68 "$n" "$@" 3>&1 1>&2 2>&3
}

_txt_checklist() {
    text=$2; shift 2
    printf '%b\n' "$text" >&2
    i=1; def=""
    while [ $# -ge 3 ]; do
        mark=" "
        if [ "$3" = "ON" ]; then mark="*"; def="$def $1"; fi
        echo "  $i) [$mark] $2" >&2
        eval "TAG_$i=\$1"
        i=$((i + 1)); shift 3
    done
    printf "Votre choix (ex : 1 3 ; Entrée = cases [*]) : " >&2
    read -r c
    if [ -z "$c" ]; then echo $def; return 0; fi
    res=""
    for k in $c; do
        case "$k" in ''|*[!0-9]*) continue ;; esac
        eval "t=\${TAG_$k:-}"
        [ -n "$t" ] && res="$res $t"
    done
    echo $res
}

ui_checklist() {
    if [ "$UI" = gui ]; then
        out=$(_gui_checklist "$@"); rc=$?
        if [ "$rc" -le 1 ]; then printf '%s\n' "$out"; return 0; fi
        fallback_ui
    fi
    case "$UI" in
        whiptail) _wt_checklist "$@" ;;
        *)        _txt_checklist "$@" ;;
    esac
}

# --- Question oui / non ------------------------------------------------------
# ui_yesno TITRE TEXTE   -> code retour 0 = oui, 1 = non

_gui_yesno() {
    zenity --question --title="$1" --text="$(printf '%b' "$2")" \
        --ok-label="Continuer" --cancel-label="Annuler" --width=420 2>/dev/null
}

ui_yesno() {
    if [ "$UI" = gui ]; then
        _gui_yesno "$@"; rc=$?
        [ "$rc" -le 1 ] && return "$rc"
        fallback_ui
    fi
    case "$UI" in
        whiptail)
            whiptail --title "$1" --yesno "$2" 15 58
            return $?
            ;;
        *)
            printf '%b\n' "$2"
            printf "Continuer ? [o/N] : "
            read -r a
            case "$a" in [oOyY]*) return 0 ;; *) return 1 ;; esac
            ;;
    esac
}

# --- Message d'information ---------------------------------------------------
# ui_msg TITRE TEXTE BOUTON

_gui_msg() {
    zenity --info --title="$1" --text="$(printf '%b' "$2")" \
        --ok-label="$3" --width=420 2>/dev/null
}

ui_msg() {
    if [ "$UI" = gui ]; then
        _gui_msg "$@"; rc=$?
        [ "$rc" -le 1 ] && return 0
        fallback_ui
    fi
    case "$UI" in
        whiptail) whiptail --title "$1" --ok-button "$3" --msgbox "$2" 16 60 ;;
        *)        printf '%b\n' "$2" ;;
    esac
}

# --- Écran d'accueil --------------------------------------------------------
anim_ok() { [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; }

cursor_hide() { anim_ok && printf '\033[?25l'; }
cursor_show() { anim_ok && printf '\033[?25h'; }

trap cursor_show EXIT
trap 'exit 130' INT TERM

color() { printf '\033[38;5;%sm' "$1"; }
reset_color() { printf '\033[0m'; }

anim_logo() {
    local -a gradient=(27 33 39 45 51)
    local i=0 line
    while IFS= read -r line; do
        color "${gradient[i]}"
        printf '  %s\n' "$line"
        reset_color
        i=$((i + 1))
        sleep 0.12
    done <<'LOGO'
 _   _                  ___   ____
| \ | |  ___   _ __    ___   / _ \ / ___|
|  \| | / _ \ | '_ \  / _ \ | | | |\___ \
| |\  || (_) || | | || (_) || |_| | ___) |
|_| \_| \___/ |_| |_| \___/  \___/ |____/
LOGO
    printf '\n'
}

anim_spinner() {
    local msg=$1 duration=${2:-2}
    local -a frames=('|' '/' '-' '\\')
    local end=$((SECONDS + duration)) i=0
    while [ "$SECONDS" -lt "$end" ]; do
        printf '\r\033[36m%s\033[0m %s' "${frames[i % ${#frames[@]}]}" "$msg"
        i=$((i + 1))
        sleep 0.08
    done
    printf '\r\033[32mOK\033[0m %s\033[K\n' "$msg"
}

anim_progress() {
    local label=$1 width=${2:-30} p filled j bar
    for ((p = 0; p <= 100; p += 2)); do
        filled=$((p * width / 100))
        bar=
        for ((j = 0; j < width; j++)); do
            if [ "$j" -lt "$filled" ]; then bar+='#'; else bar+='-'; fi
        done
        printf '\r%s \033[36m%s\033[0m %3d%%' "$label" "$bar" "$p"
        sleep 0.03
    done
    printf '\n'
}

ui_welcome() {
    local welcome_text="Bienvenue dans nonoos !\n\nCet assistant va vous aider à préparer votre système.\n\n1. Choisir la langue\n2. Configurer le clavier\n3. Installer vos applications"
    local rc p

    case "$UI" in
        gui)
            (
                for ((p = 0; p <= 100; p += 4)); do
                    printf '%s\n# Démarrage de nonoos... %s%%\n' "$p" "$p"
                    sleep 0.04
                done
            ) | zenity --progress --title="$TITLE" --percentage=0 \
                --auto-close --no-cancel --width=480 2>/dev/null

            zenity --info --title="$TITLE" --text="$(printf '%b' "$welcome_text")" \
                --ok-label="Commencer" --width=480 2>/dev/null
            rc=$?
            if [ "$rc" -le 1 ]; then
                return 0
            fi
            fallback_ui
            ;;
        whiptail)
            for ((p = 0; p <= 100; p += 5)); do
                printf '%s\n' "$p"
                sleep 0.04
            done | whiptail --title "$TITLE" --gauge "Démarrage de nonoos..." 7 64 0
            whiptail --title "$TITLE" --msgbox "$welcome_text" 15 64
            ;;
        *)
            if anim_ok; then
                cursor_hide
                clear
                printf '\n'
                anim_logo
                printf '%b\n' "$welcome_text"
                printf '\n'
                anim_spinner "Préparation de l'assistant" 2
                anim_progress "Préparation du système"
                printf '\n'
                cursor_show
            else
                printf '%b\n' "$welcome_text"
            fi
            printf "Appuyez sur Entrée pour commencer... "
            read -r _
            ;;
    esac
}

# Génère l'inventaire matériel partagé avec l'outil accessible depuis le bureau.
detect_hardware() {
    HARDWARE_REPORT=$(/usr/local/bin/nonoos-hardware)
    log "Rapport matériel détecté : $(printf '%s' "$HARDWARE_REPORT" | tr '\n' ';')"
}

# ---------------------------------------------------------------------------
# Les listes de paquets sont fournies dans $PKG_DIR et peuvent être modifiées
# avant la construction de l'ISO. Une ligne = un paquet ; les lignes vides et
# les commentaires commençant par # sont ignorés.
# ---------------------------------------------------------------------------

# Paquets de langue supplémentaires (profil bureautique uniquement)
language_packages() {
    case "$1" in
        fr_FR*) echo "libreoffice-l10n-fr hunspell-fr" ;;
        en_US*) echo "libreoffice-l10n-en-us hunspell-en-us" ;;
        es_ES*) echo "libreoffice-l10n-es hunspell-es" ;;
        de_DE*) echo "libreoffice-l10n-de hunspell-de-de" ;;
        it_IT*) echo "libreoffice-l10n-it hunspell-it" ;;
        pt_BR*) echo "libreoffice-l10n-pt-br hunspell-pt-br" ;;
    esac
}

# ---------------------------------------------------------------------------
# Questions à l'utilisateur
# ---------------------------------------------------------------------------

ask_language() {
    LANG_CHOICE=$(ui_menu "$TITLE" "Choisissez votre langue" "fr_FR.UTF-8" \
        "fr_FR.UTF-8" "Français" \
        "en_US.UTF-8" "English" \
        "es_ES.UTF-8" "Español" \
        "de_DE.UTF-8" "Deutsch" \
        "it_IT.UTF-8" "Italiano" \
        "pt_BR.UTF-8" "Português")
    [ -z "$LANG_CHOICE" ] && LANG_CHOICE="fr_FR.UTF-8"
}

ask_keyboard() {
    # Clavier proposé par défaut selon la langue choisie
    case "$LANG_CHOICE" in
        en_US*) KB_DEFAULT="us" ;;
        es_ES*) KB_DEFAULT="es" ;;
        de_DE*) KB_DEFAULT="de" ;;
        it_IT*) KB_DEFAULT="it" ;;
        pt_BR*) KB_DEFAULT="br" ;;
        *)      KB_DEFAULT="fr" ;;
    esac
    KB_CHOICE=$(ui_menu "$TITLE" "Choisissez la disposition de votre clavier" "$KB_DEFAULT" \
        "fr"    "Français (AZERTY)" \
        "be"    "Belge (AZERTY)" \
        "ch:fr" "Suisse romand (QWERTZ)" \
        "ca:fr" "Canadien français" \
        "us"    "Américain (QWERTY)" \
        "gb"    "Britannique (QWERTY)" \
        "es"    "Espagnol" \
        "de"    "Allemand (QWERTZ)" \
        "it"    "Italien" \
        "br"    "Portugais (Brésil)")
    [ -z "$KB_CHOICE" ] && KB_CHOICE="$KB_DEFAULT"
}

ask_profiles() {
    PROFILES=$(ui_checklist "$TITLE" \
        "Choisissez un ou plusieurs profils d'applications" \
        "office"     "Bureautique"   ON \
        "developing" "Développeur"   OFF \
        "cybersec"   "Cybersécurité" OFF \
        "vieprivee"  "Vie privée"     OFF \
        "serveur"    "Serveur"        OFF \
        "multimedia" "Multimédia"     OFF \
        "education"  "Éducation"      OFF \
        "gaming"     "Jeux"           OFF \
        "custom"     "Personnalisé (liste modifiable)" OFF)
    PROFILES=$(echo $PROFILES)          # nettoie espaces et retours à la ligne

    # Par défaut : bureautique
    [ -z "$PROFILES" ] && PROFILES="office"
}

ask_user_profile() {
    USER_PROFILE=$(ui_menu "$TITLE" \
        "Choisissez le profil personnel de l’utilisateur. Ce choix ne modifie pas ses privilèges." \
        "standard" \
        "standard" "Standard — usage quotidien" \
        "developer" "Développeur — développement logiciel" \
        "support" "Support — diagnostic et assistance")
    case "$USER_PROFILE" in
        developer|support|standard) ;;
        *) USER_PROFILE="standard" ;;
    esac
}

ask_system_services() {
    if ui_yesno "$TITLE" "Activer le service SSH pour l'accès distant depuis le réseau ?"; then
        SSH_ENABLED="yes"
    else
        SSH_ENABLED="no"
    fi

    if ui_yesno "$TITLE" "Activer le support Bluetooth sur cet ordinateur ?"; then
        BLUETOOTH_ENABLED="yes"
    else
        BLUETOOTH_ENABLED="no"
    fi
}

# ---------------------------------------------------------------------------
# Saisie d'un utilisateur et de ses privilèges
# ---------------------------------------------------------------------------
# ui_input : demande une chaîne simple à l'utilisateur (nom, login, etc.)
# ui_password : demande un mot de passe sans l'afficher
# ask_user_account : collecte le nom du compte et le mode d'accès (sudo ou standard)
# ---------------------------------------------------------------------------
ui_input() {
    title=$1
    text=$2
    default=$3

    case "$UI" in
        gui)
            zenity --entry --title="$title" --text="$text" --entry-text="$default" 2>/dev/null
            ;;
        whiptail)
            whiptail --title "$title" --inputbox "$text" 10 58 "$default" 3>&1 1>&2 2>&3
            ;;
        *)
            printf '%b\n' "$text" >&2
            printf "[%s] : " "$default" >&2
            read -r value
            [ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' "$default"
            ;;
    esac
}

ui_password() {
    title=$1
    text=$2

    case "$UI" in
        gui)
            zenity --password --title="$title" --text="$text" 2>/dev/null
            ;;
        whiptail)
            whiptail --title "$title" --passwordbox "$text" 10 58 3>&1 1>&2 2>&3
            ;;
        *)
            printf '%b\n' "$text" >&2
            stty -echo
            read -r value
            stty echo
            printf '\n'
            printf '%s\n' "$value"
            ;;
    esac
}

is_first_user_account() {
    # Le premier compte est celui qui est créé quand aucun compte utilisateur normal n’existe encore.
    # On ignore root et les comptes système ; un compte humain standard est généralement >= 1000.
    local user_count
    user_count=$(getent passwd | awk -F: '$3 >= 1000 {count++} END {print count + 0}')
    [ "$user_count" -eq 0 ]
}

find_regular_user() {
    getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 && $7 !~ /(nologin|false)$/ { print $1; exit }'
}

prompt_password_with_confirmation() {
    local prompt_text="$1"
    local pass1=""
    local pass2=""

    while :; do
        pass1=$(ui_password "$TITLE" "$prompt_text")
        if [ -z "$pass1" ]; then
            ui_msg "$TITLE" "Le mot de passe ne peut pas être vide. Réessayez." "Réessayer"
            continue
        fi

        pass2=$(ui_password "$TITLE" "Confirmez le mot de passe")
        if [ "$pass1" = "$pass2" ]; then
            printf '%s\n' "$pass1"
            return 0
        fi

        ui_msg "$TITLE" "Les mots de passe ne correspondent pas. Réessayez." "Réessayer"
    done
}

ask_user_account() {
    # Détection du premier compte : on force le sudo pour le compte principal.
    if is_first_user_account; then
        USER_PRIVILEGES="sudo"
        ui_msg "$TITLE" "Ceci est le premier compte utilisateur. Il sera créé avec les droits sudo." "Continuer"
    else
        # Le deuxième compte et suivants peuvent choisir leur niveau d'accès.
        USER_PRIVILEGES=$(ui_menu "$TITLE" "Choisissez les privilèges du compte" "user" \
            "sudo" "Administrateur (sudo)" \
            "user" "Utilisateur standard")
        [ -z "$USER_PRIVILEGES" ] && USER_PRIVILEGES="user"
    fi

    # Nom du compte principal de l'utilisateur
    USER_NAME=$(ui_input "$TITLE" "Nom de l’utilisateur" "nono")
    USER_NAME=$(printf '%s' "$USER_NAME" | tr -d '[:space:]')
    [ -z "$USER_NAME" ] && USER_NAME="nono"

    # Pour le premier compte, on force le mot de passe avec double saisie + vérification.
    if [ "$USER_PRIVILEGES" = "sudo" ] && is_first_user_account; then
        USER_PASSWORD=$(prompt_password_with_confirmation "Définissez le mot de passe du premier compte sudo")
    elif [ "$USER_PRIVILEGES" = "sudo" ]; then
        # Pour un compte sudo supplémentaire, il faut entrer un mot de passe de validation.
        USER_PASSWORD=$(prompt_password_with_confirmation "Définissez le mot de passe du compte sudo")
    else
        USER_PASSWORD=$(prompt_password_with_confirmation "Définissez le mot de passe de l’utilisateur")
    fi
}

# create_user_account :
# - crée le compte si nécessaire
# - définit le mot de passe
# - ajoute l'utilisateur au groupe sudo si le mode le demande
create_user_account() {
    local username="${1:-}"
    local pass="${2:-}"
    local privileges="${3:-user}"

    if [ -z "$username" ]; then
        log "ERREUR : nom d'utilisateur vide, création du compte impossible."
        return 1
    fi
    if [ -z "$pass" ]; then
        log "ERREUR : mot de passe vide, création du compte $username impossible."
        return 1
    fi

    # L'outil useradd n'est pas toujours présent dans les images minimales.
    if ! command -v useradd >/dev/null 2>&1; then
        if ! apt-get install -y passwd >>"$LOG_FILE" 2>&1; then
            log "Impossible d'installer le paquet passwd."
            return 1
        fi
    fi

    if id -u "$username" >/dev/null 2>&1; then
        log "Utilisateur $username déjà présent."
    else
        if ! useradd -m -s /bin/bash "$username"; then
            log "Impossible de créer le compte $username."
            return 1
        fi
        log "Compte utilisateur créé : $username"
    fi

    # Définition du mot de passe avec chpasswd, ce qui est plus fiable qu'un shell interactif.
    if ! printf '%s:%s\n' "$username" "$pass" | chpasswd; then
        log "Impossible de définir le mot de passe du compte $username."
        return 1
    fi

    # Gestion des privilèges sudo
    if [ "$privileges" = "sudo" ]; then
        if ! command -v sudo >/dev/null 2>&1; then
            if ! apt-get install -y sudo >>"$LOG_FILE" 2>&1; then
                log "Impossible d'installer le paquet sudo."
                return 1
            fi
        fi
        if ! getent group sudo >/dev/null; then
            if ! groupadd -f sudo; then
                log "Impossible de créer le groupe sudo."
                return 1
            fi
        fi
        if ! usermod -aG sudo "$username"; then
            log "Impossible d'ajouter $username au groupe sudo."
            return 1
        fi
        log "Droits sudo accordés à $username"
    fi

    return 0
}
# ---------------------------------------------------------------------------
# Services système : SSH et Bluetooth
# ---------------------------------------------------------------------------

enable_ssh_service() {
    if [ "$SSH_ENABLED" != "yes" ]; then
        log "SSH désactivé par l'utilisateur."
        return 0
    fi

    if ! command -v apt-get >/dev/null 2>&1; then
        log "SSH : apt-get non disponible, impossible d'installer openssh-server."
        return 1
    fi

    if ! dpkg -s openssh-server >/dev/null 2>&1; then
        if ! apt-get install -y openssh-server >>"$LOG_FILE" 2>&1; then
            log "SSH : installation de openssh-server échouée."
            return 1
        fi
    fi

    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl enable --now ssh >>"$LOG_FILE" 2>&1; then
            log "SSH : impossible d'activer ou de démarrer le service."
            return 1
        fi
    elif command -v service >/dev/null 2>&1; then
        if command -v update-rc.d >/dev/null 2>&1; then
            if ! update-rc.d ssh defaults >>"$LOG_FILE" 2>&1; then
                log "SSH : impossible d'activer le service au démarrage."
                return 1
            fi
        else
            log "SSH : impossible de configurer le démarrage automatique."
            return 1
        fi
        if ! service ssh restart >>"$LOG_FILE" 2>&1; then
            log "SSH : impossible de démarrer le service."
            return 1
        fi
    else
        log "SSH : aucun gestionnaire de service disponible."
        return 1
    fi

    log "SSH activé"
    return 0
}

enable_bluetooth_service() {
    if [ "$BLUETOOTH_ENABLED" != "yes" ]; then
        log "Bluetooth désactivé par l'utilisateur."
        return 0
    fi

    if ! command -v apt-get >/dev/null 2>&1; then
        log "Bluetooth : apt-get non disponible, impossible d'installer bluez."
        return 1
    fi

    local package_found=no
    for pkg in bluez bluez-utils; do
        if dpkg -s "$pkg" >/dev/null 2>&1; then
            package_found=yes
        elif apt-cache show "$pkg" >/dev/null 2>&1; then
            package_found=yes
            if ! apt-get install -y "$pkg" >>"$LOG_FILE" 2>&1; then
                log "Bluetooth : installation de $pkg échouée."
                return 1
            fi
        fi
    done

    if [ "$package_found" != yes ]; then
        log "Bluetooth : aucun paquet BlueZ disponible."
        return 1
    fi

    if ! command -v systemctl >/dev/null 2>&1; then
        log "Bluetooth : systemctl indisponible, impossible d'activer le service."
        return 1
    fi
    if ! systemctl enable --now bluetooth >>"$LOG_FILE" 2>&1; then
        log "Bluetooth : impossible d'activer ou de démarrer le service."
        return 1
    fi
    if command -v rfkill >/dev/null 2>&1 && ! rfkill unblock bluetooth >>"$LOG_FILE" 2>&1; then
        log "Bluetooth : impossible de débloquer l'interface avec rfkill."
        return 1
    fi

    log "Bluetooth activé"
    return 0
}

is_server_profile_selected() {
    case " $1 " in
        *" serveur "*) return 0 ;;
        *) return 1 ;;
    esac
}

profile_display_mode() {
    if is_server_profile_selected "$1"; then
        printf '%s' "Désactivée (mode console)"
    else
        printf '%s' "KDE Plasma"
    fi
}

configure_server_mode() {
    profiles="$1"
    is_server_profile_selected "$profiles" || return 0

    if ! command -v systemctl >/dev/null 2>&1; then
        log "ERREUR : systemctl indisponible, impossible de configurer le mode serveur sans interface graphique."
        return 1
    fi

    if ! systemctl set-default multi-user.target >>"$LOG_FILE" 2>&1; then
        log "ERREUR : impossible de définir le démarrage en mode console."
        return 1
    fi

    display_manager=$(systemctl show --property=Id --value display-manager.service 2>>"$LOG_FILE") || display_manager=""
    if [ -n "$display_manager" ]; then
        if ! systemctl disable "$display_manager" >>"$LOG_FILE" 2>&1; then
            log "ERREUR : impossible de désactiver $display_manager."
            return 1
        fi
        if ! systemctl stop "$display_manager" >>"$LOG_FILE" 2>&1; then
            log "ERREUR : impossible d'arrêter $display_manager."
            return 1
        fi
    fi

    log "Mode serveur configuré : démarrage en console, interface graphique désactivée."
    return 0
}

# ---------------------------------------------------------------------------
# Application de la configuration
# ---------------------------------------------------------------------------

apply_locale() {
    printf '%s\n' "LANG=$LANG_CHOICE" "LANGUAGE=${LANG_CHOICE%%.*}" > "$LOCALE_FILE"
    export LANG="$LANG_CHOICE" LANGUAGE="${LANG_CHOICE%%.*}"

    if command -v locale-gen >/dev/null 2>&1; then
        if [ -f /etc/locale.gen ] && grep -q "^#[[:space:]]*$LANG_CHOICE UTF-8" /etc/locale.gen; then
            sed -i "s/^#[[:space:]]*\($LANG_CHOICE UTF-8\)/\1/" /etc/locale.gen
            locale-gen >/dev/null 2>&1
        else
            locale-gen "$LANG_CHOICE" >/dev/null 2>&1
        fi
    fi
    log "Locale : $LANG_CHOICE"
}

apply_keyboard() {
    KB_LAYOUT="${KB_CHOICE%%:*}"
    case "$KB_CHOICE" in
        *:*) KB_VARIANT="${KB_CHOICE#*:}" ;;
        *)   KB_VARIANT="" ;;
    esac

    cat > "$KEYBOARD_FILE" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$KB_LAYOUT"
XKBVARIANT="$KB_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF

    # Console (TTY)
    command -v setupcon >/dev/null 2>&1 && setupcon --save >/dev/null 2>&1
    # Session graphique (systemd)
    if command -v localectl >/dev/null 2>&1; then
        localectl set-x11-keymap "$KB_LAYOUT" pc105 "$KB_VARIANT" >/dev/null 2>&1
    fi
    # Application immédiate pour la session en cours
    command -v loadkeys >/dev/null 2>&1 && loadkeys "$KB_LAYOUT" >/dev/null 2>&1
    log "Clavier : layout=$KB_LAYOUT variant=$KB_VARIANT"
}

# ---------------------------------------------------------------------------
# Connexion Wi‑Fi : détection de la carte Wi‑Fi, choix du SSID, mot de passe,
# puis connexion via NetworkManager ou fallback wpa_supplicant.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Connexion Wi‑Fi : détection de la carte Wi‑Fi, choix du SSID, mot de passe,
# puis connexion via NetworkManager ou fallback wpa_supplicant.
#
# Ce bloc est important pour le premier boot car il permet au système de se
# connecter au réseau avant d'installer les paquets avec apt-get. S'il n'y a pas
# de Wi‑Fi, le script continue normalement sans bloquer l'installation.
# ---------------------------------------------------------------------------

detect_wifi_interface() {
    # 1) On tente d'utiliser NetworkManager si présent, car c'est le gestionnaire le
    #    plus simple pour gérer la connexion Wi‑Fi en mode graphique ou en console.
    if command -v nmcli >/dev/null 2>&1; then
        local iface
        iface=$(nmcli -t -f DEVICE device status 2>/dev/null | awk 'NF && $0 !~ /lo/ {print $1; exit}')
        [ -n "$iface" ] && { echo "$iface"; return 0; }
    fi

    # 2) Fallback standard Linux : on regarde les interfaces réseau qui exposent une
    #    carte Wi‑Fi (via iw ou le dossier /sys/class/net).
    if command -v iw >/dev/null 2>&1; then
        local iface
        iface=$(iw dev 2>/dev/null | awk '$1=="Interface" {print $2; exit}')
        [ -n "$iface" ] && { echo "$iface"; return 0; }
    fi

    if [ -d /sys/class/net ]; then
        for d in /sys/class/net/*; do
            name=${d##*/}
            if [ -e "$d/wireless" ] || [ -e "$d/phy80211" ]; then
                echo "$name"
                return 0
            fi
        done
    fi

    return 1
}

wifi_scan_ssids() {
    # Liste les réseaux Wi‑Fi visibles pour l'interface sélectionnée.
    local iface="$1"

    if command -v nmcli >/dev/null 2>&1; then
        nmcli -t -f SSID device wifi list ifname "$iface" 2>/dev/null | sed '/^$/d' | awk '!seen[$0]++'
        return 0
    fi

    if command -v iw >/dev/null 2>&1; then
        iw dev "$iface" scan 2>/dev/null | awk -F'"' '/SSID:/{print $2}' | awk '!seen[$0]++'
        return 0
    fi

    return 1
}

connect_wifi_nm() {
    # Connexion Wi‑Fi via NetworkManager : méthode recommandée si le système l'a.
    local iface="$1"
    local ssid="$2"
    local pass="$3"

    if ! command -v nmcli >/dev/null 2>&1; then
        if ! apt-get install -y network-manager >/dev/null 2>&1; then
            log "ERREUR : impossible d'installer NetworkManager pour le Wi‑Fi."
            return 1
        fi
    fi

    nmcli radio wifi on >/dev/null 2>&1 || true
    if nmcli device wifi connect "$ssid" password "$pass" ifname "$iface" >/dev/null 2>&1; then
        log "Connexion Wi‑Fi réussie via NetworkManager : $ssid"
        return 0
    fi

    # Si la première tentative ne fonctionne pas, on crée explicitement la connexion WPA/WPA2.
    nmcli connection delete "$ssid" >/dev/null 2>&1 || true
    if nmcli connection add type wifi ifname "$iface" con-name "$ssid" ssid "$ssid" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pass" >/dev/null 2>&1 && \
       nmcli connection up "$ssid" >/dev/null 2>&1; then
        log "Connexion Wi‑Fi enregistrée et activée : $ssid"
        return 0
    fi

    log "ERREUR : connexion Wi‑Fi NetworkManager impossible pour $ssid"
    return 1
}

connect_wifi_wpa() {
    # Fallback très robuste : configuration locale avec wpa_supplicant.
    local iface="$1"
    local ssid="$2"
    local pass="$3"

    if ! command -v wpa_supplicant >/dev/null 2>&1; then
        if ! apt-get install -y wpasupplicant >/dev/null 2>&1; then
            log "ERREUR : impossible d'installer wpa_supplicant pour le Wi‑Fi."
            return 1
        fi
    fi

    mkdir -p /etc/wpa_supplicant
    cat > "/etc/wpa_supplicant/wpa_supplicant-$iface.conf" <<EOF
ctrl_interface=/var/run/wpa_supplicant
update_config=1
country=FR

network={
    ssid="$ssid"
    psk="$pass"
    key_mgmt=WPA-PSK
}
EOF

    if wpa_supplicant -B -i "$iface" -c "/etc/wpa_supplicant/wpa_supplicant-$iface.conf" >/dev/null 2>&1; then
        if command -v dhclient >/dev/null 2>&1; then
            dhclient "$iface" >/dev/null 2>&1 || true
        fi
        log "Connexion Wi‑Fi réussie via wpa_supplicant : $ssid"
        return 0
    fi

    log "ERREUR : wpa_supplicant impossible pour $ssid"
    return 1
}

setup_wifi_connection() {
    # Point d'entrée du raccordement Wi‑Fi. Si aucune interface n'est détectée,
    # le script continue normalement et ne bloque pas la configuration du système.
    WIFI_INTERFACE=$(detect_wifi_interface)
    if [ -z "$WIFI_INTERFACE" ]; then
        log "Aucune interface Wi‑Fi détectée."
        return 1
    fi

    # Demande à l'utilisateur s'il souhaite se connecter à un réseau sans bloquer
    # le reste de la configuration si l'utilisateur refuse.
    if ! ui_yesno "$TITLE" "Une interface Wi‑Fi a été détectée ($WIFI_INTERFACE).\nVoulez-vous vous connecter à un réseau Wi‑Fi ?"; then
        log "Connexion Wi‑Fi refusée par l'utilisateur."
        return 1
    fi

    # On essaie de proposer les SSID visibles pour faciliter la connexion.
    WIFI_SSID=""
    if command -v nmcli >/dev/null 2>&1; then
        SSID_LIST=$(wifi_scan_ssids "$WIFI_INTERFACE")
        if [ -n "$SSID_LIST" ]; then
            WIFI_SSID=$(ui_menu "$TITLE" "Choisissez votre réseau Wi‑Fi" "" \
                $(for s in $SSID_LIST; do printf '%s %s ' "$s" "$s"; done))
        fi
    fi

    # Sinon, on demande le SSID manuellement.
    if [ -z "$WIFI_SSID" ]; then
        WIFI_SSID=$(ui_input "$TITLE" "Nom du réseau Wi‑Fi (SSID)" "MonRéseau")
    fi

    [ -z "$WIFI_SSID" ] && return 1

    # Le mot de passe est saisi sans affichage pour éviter de l'afficher sur l'écran.
    WIFI_PASSWORD=$(ui_password "$TITLE" "Mot de passe du réseau Wi‑Fi $WIFI_SSID")
    [ -z "$WIFI_PASSWORD" ] && return 1

    # On essaye d'abord la méthode moderne avec NetworkManager.
    if command -v nmcli >/dev/null 2>&1; then
        if connect_wifi_nm "$WIFI_INTERFACE" "$WIFI_SSID" "$WIFI_PASSWORD"; then
            return 0
        fi
    fi

    # Fallback sur wpa_supplicant si NetworkManager ne convient pas ou n'existe pas.
    if command -v wpa_supplicant >/dev/null 2>&1 || command -v apt-get >/dev/null 2>&1; then
        if connect_wifi_wpa "$WIFI_INTERFACE" "$WIFI_SSID" "$WIFI_PASSWORD"; then
            return 0
        fi
    fi

    ui_msg "$TITLE" "Échec de la connexion Wi‑Fi. Vérifiez le SSID et le mot de passe." "Réessayer"
    return 1
}

# Installe les paquets des listes correspondant aux profils choisis.
# Retourne 0 si tout s'est bien passé, 1 sinon.
install_profiles() {
    profiles="$1"
    PKG_TODO=""
    PKG_MISSING=""

    export DEBIAN_FRONTEND=noninteractive

    if ! apt-get update >>"$LOG_FILE" 2>&1; then
        log "ERREUR : apt-get update a échoué (réseau ?)"
        return 1
    fi

    for p in $profiles; do
        list="$PKG_DIR/$p.list"
        if [ ! -r "$list" ]; then
            log "ERREUR : liste de profil introuvable : $list"
            return 1
        fi

        for pkg in $(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$list"); do
            if apt-cache show "$pkg" >/dev/null 2>&1; then
                PKG_TODO="$PKG_TODO $pkg"
            else
                PKG_MISSING="$PKG_MISSING $pkg"
            fi
        done

        # Paquets de langue pour la bureautique
        if [ "$p" = "office" ]; then
            for pkg in $(language_packages "$LANG_CHOICE"); do
                if apt-cache show "$pkg" >/dev/null 2>&1; then
                    PKG_TODO="$PKG_TODO $pkg"
                else
                    PKG_MISSING="$PKG_MISSING $pkg"
                fi
            done
        fi
    done

    # Suppression des doublons
    PKG_TODO=$(printf '%s\n' $PKG_TODO | sort -u | tr '\n' ' ')

    [ -n "$PKG_MISSING" ] && log "Paquets indisponibles (ignorés) :$PKG_MISSING"

    if [ -z "$PKG_TODO" ]; then
        log "Aucun paquet à installer."
        return 0
    fi

    log "Installation de : $PKG_TODO"
    # shellcheck disable=SC2086
    if apt-get install -y $PKG_TODO >>"$LOG_FILE" 2>&1; then
        log "Installation terminée."
        return 0
    else
        log "ERREUR : apt-get install a échoué."
        return 1
    fi
}

# Lance l'installation avec un indicateur de progression adapté à l'interface
run_install() {
    profiles="$1"
    wait_msg="Installation des applications en cours...\nCela peut prendre plusieurs minutes."

    case "$UI" in
        gui)
            install_profiles "$profiles" &
            inst_pid=$!
            ( while kill -0 "$inst_pid" 2>/dev/null; do echo "#"; sleep 1; done ) | \
                zenity --progress --pulsate --no-cancel --auto-close \
                    --title="$TITLE" --text="$(printf '%b' "$wait_msg")" \
                    --width=420 2>/dev/null
            wait "$inst_pid"
            return $?
            ;;
        whiptail)
            whiptail --title "$TITLE" --infobox "$wait_msg" 8 56
            install_profiles "$profiles"
            return $?
            ;;
        *)
            printf '%b\n' "$wait_msg"
            echo "(journal : $LOG_FILE)"
            install_profiles "$profiles"
            return $?
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Mode --install-only : réinstalle les profils déjà enregistrés
# ---------------------------------------------------------------------------

if [ "${1:-}" = "--install-only" ] || \
   { [ -e "$SETUP_READY_MARKER" ] && [ ! -e "$MARKER" ]; }; then
    if [ ! -r "$PROFILE_FILE" ]; then
        echo "Aucun profil enregistré ($PROFILE_FILE)." >&2
        exit 1
    fi
    [ -r "$LOCALE_FILE" ] && . "$LOCALE_FILE" && LANG_CHOICE="${LANG:-$LANG_CHOICE}"
    PROFILES=$(cat "$PROFILE_FILE")
    detect_ui
    run_install "$PROFILES"
    rc=$?
    if ! configure_server_mode "$PROFILES"; then
        rc=1
    fi
    if [ "$rc" -eq 0 ]; then
        if [ -e "$SETUP_READY_MARKER" ]; then
            if touch "$MARKER"; then
                rm -f -- "$SETUP_READY_MARKER"
                rm -f -- "$0"
                ui_msg "$TITLE" "Applications installées et configuration initiale terminée." "Terminer"
            else
                ui_msg "$TITLE" "Impossible d'enregistrer la fin de configuration. Relancez le script avec --install-only." "Terminer"
                exit 1
            fi
        else
            ui_msg "$TITLE" "Applications installées. La configuration initiale reste incomplète ; relancez le script sans option pour la terminer." "Terminer"
        fi
    else
        ui_msg "$TITLE" "Installation incomplète ou configuration du mode serveur impossible.\nLe script est conservé. Relancez : $0 --install-only\nVoir le journal : $LOG_FILE" "Terminer"
    fi
    exit "$rc"
fi

# ---------------------------------------------------------------------------
# Programme principal
# ---------------------------------------------------------------------------

# Une seule exécution
[ -e "$MARKER" ] && exit 0

mkdir -p "$STATE_DIR"
: >> "$LOG_FILE"

detect_ui
log "Interface utilisée : $UI"
ui_welcome
detect_hardware
ui_msg "$TITLE" \
    "Matériel détecté :\n\n$HARDWARE_REPORT\n\nLe rapport est enregistré dans $LOG_FILE." \
    "Continuer"

ask_language
ask_keyboard
ask_profiles
ask_user_profile
ask_system_services

# Récapitulatif + confirmation
if ! ui_yesno "$TITLE" \
    "Récapitulatif :\n\nLangue               : $LANG_CHOICE\nClavier              : $KB_CHOICE\nProfil(s) logiciels  : $PROFILES\nProfil utilisateur   : $USER_PROFILE\nBureau               : $(profile_display_mode "$PROFILES")\nSSH                  : $SSH_ENABLED\nBluetooth            : $BLUETOOTH_ENABLED\n\nLes applications associées vont être installées."
then
    echo "Configuration annulée. Relancez le script pour recommencer." >&2
    exit 1
fi

apply_locale
apply_keyboard

# Tentative de connexion Wi‑Fi avant l'installation des paquets, pour que apt puisse
# accéder aux dépôts réseau lorsqu'une interface Wi‑Fi est disponible.
setup_wifi_connection || true

# Debian Installer crée déjà le compte lors d'une installation sur disque.
# En session live, il faut créer un compte distinct pour l'installation suivante.
if ! grep -qw 'boot=live' /proc/cmdline && USER_NAME=$(find_regular_user) && [ -n "$USER_NAME" ]; then
    USER_PRIVILEGES="configurés par Debian Installer"
    log "Compte utilisateur existant conservé : $USER_NAME"
else
    ask_user_account
    if ! create_user_account "$USER_NAME" "$USER_PASSWORD" "$USER_PRIVILEGES"; then
        record_failure "Création ou configuration du compte $USER_NAME échouée."
    fi
fi

if id -u "$USER_NAME" >/dev/null 2>&1; then
    if ! /usr/local/bin/nonoos-profile --set "$USER_PROFILE" --user "$USER_NAME"; then
        record_failure "Enregistrement du profil personnel de $USER_NAME échoué."
    fi
else
    record_failure "Impossible d'enregistrer un profil personnel sans compte utilisateur."
fi

# Proposer la récupération des fichiers de l'ancienne installation avant de
# terminer la configuration de NonoOS.
if [ "$FIRST_BOOT_FAILED" = no ] && command -v nonoos-migration-assistant >/dev/null 2>&1; then
    if ui_yesno "$TITLE" \
        "Voulez-vous récupérer maintenant vos fichiers personnels depuis une ancienne installation ?\n\nLa source sera ouverte en lecture seule et les fichiers existants ne seront pas écrasés."
    then
        if nonoos-migration-assistant "$USER_NAME"; then
            ui_msg "$TITLE" "Récupération des fichiers terminée." "Continuer"
        else
            migration_rc=$?
            if [ "$migration_rc" -ne 2 ]; then
                record_failure "La récupération des fichiers a échoué. Consultez /var/log/newdistrib-migration.log."
                ui_msg "$TITLE" "La récupération des fichiers a échoué.\n\nLa configuration continue, mais consultez /var/log/newdistrib-migration.log." "Continuer"
            fi
        fi
    fi
fi

# Activation des services système sélectionnés.
if ! enable_ssh_service; then
    record_failure "Activation du service SSH échouée."
fi
if ! enable_bluetooth_service; then
    record_failure "Activation du service Bluetooth échouée."
fi

# Sauvegarde des profils (permet de relancer avec --install-only)
if ! printf '%s\n' "$PROFILES" > "$PROFILE_FILE"; then
    record_failure "Impossible d'enregistrer les profils sélectionnés."
fi

if ! configure_server_mode "$PROFILES"; then
    record_failure "Configuration du mode serveur échouée."
fi

if [ "$FIRST_BOOT_FAILED" = no ]; then
    if ! touch "$SETUP_READY_MARKER"; then
        record_failure "Impossible d'enregistrer l'état de configuration avant installation."
    fi
fi

if run_install "$PROFILES"; then
    INSTALL_STATUS="Applications installées avec succès."
else
    PACKAGE_FAILED=yes
    INSTALL_STATUS="Installation incomplète (voir $LOG_FILE).\nRelancez : $0 --install-only"
fi

# Message final
if [ "$FIRST_BOOT_FAILED" = no ] && [ "$PACKAGE_FAILED" = no ]; then
    if touch "$MARKER"; then
        rm -f -- "$SETUP_READY_MARKER"
        rm -f -- "$0"
    else
        record_failure "Impossible d'enregistrer la fin de la configuration initiale."
    fi
fi

if [ "$FIRST_BOOT_FAILED" = yes ] || [ "$PACKAGE_FAILED" = yes ]; then
    if [ -n "$INSTALL_STATUS" ]; then
        INSTALL_STATUS+=$'\n\n'
    fi
    INSTALL_STATUS+="Échecs détectés :${FIRST_BOOT_FAILURES}"
    INSTALL_STATUS+=$'\nLe script est conservé pour permettre une nouvelle tentative.'
    ui_msg "$TITLE" \
        "Configuration initiale incomplète.\n\nLangue               : $LANG_CHOICE\nClavier              : $KB_CHOICE\nProfil(s) logiciels  : $PROFILES\nProfil utilisateur   : $USER_PROFILE\nBureau               : $(profile_display_mode "$PROFILES")\nSSH                  : $SSH_ENABLED\nBluetooth            : $BLUETOOTH_ENABLED\nUtilisateur          : $USER_NAME\nPrivilèges            : $USER_PRIVILEGES\n\n$INSTALL_STATUS" \
        "Terminer"
    exit 1
fi

ui_msg "$TITLE" \
    "Configuration initiale terminée.\n\nLangue               : $LANG_CHOICE\nClavier              : $KB_CHOICE\nProfil(s) logiciels  : $PROFILES\nProfil utilisateur   : $USER_PROFILE\nBureau               : $(profile_display_mode "$PROFILES")\nSSH                  : $SSH_ENABLED\nBluetooth            : $BLUETOOTH_ENABLED\nUtilisateur          : $USER_NAME\nPrivilèges            : $USER_PRIVILEGES\n\n$INSTALL_STATUS" \
    "Terminer"

rm -f -- "$0"